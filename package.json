{
    "name": "browser-extension-boilerplate",
    "version": "0.1.2",
    "year": "2026",
    "description": "A cross-browser extension starter template with React, MobX, TypeScript, and Webpack",
    "scripts": {
        "dev": "nodemon --watch webpack/ --exec \"webpack --config webpack/webpack.dev.js --watch\"",
        "build": "webpack --config webpack/webpack.prod.js",
        "clean": "rimraf dist",
        "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' npx jest",
        "style": "prettier --write \"src/**/*.{ts,tsx}\""
    },
    "author": "Sergey Yakunin <s@yakunins.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/yakunins/digital-clock-new-tab-extension.git"
    },
    "dependencies": {
        "mobx": "^6.15.0",
        "mobx-react": "^9.2.1",
        "react": "^19.2.4",
        "react-aria-components": "^1.15.1",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@types/chrome": "^0.1.36",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "copy-webpack-plugin": "^13.0.1",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.4",
        "glob": "^13.0.3",
        "jest": "^30.2.0",
        "nodemon": "^3.1.11",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "style-loader": "^4.0.0",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "typescript-plugin-css-modules": "^5.2.0",
        "webpack": "^5.105.2",
        "webpack-cli": "^6.0.1",
        "webpack-merge": "^6.0.1"
    }
}
